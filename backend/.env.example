# Local development only. Never use this example key in a deployed environment.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Configure these for your own local PostgreSQL database.
POSTGRES_DB=nirmansetu
POSTGRES_USER=nirmansetu
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
